#!/usr/bin/ucode

'use strict';

import { access, glob, popen, readfile, stat, writefile } from 'fs';
import { cursor } from 'uci';
import { get_users, get_groups, get_cgroups, load_profile } from '/etc/nikki/ucode/include.uc';

const repository = 'prettyleaf/openwrt-exodus';

// alternative cores chosen in the installer, their releases publish the latest version in version.txt
const core_releases = {
	alpha: 'https://github.com/MetaCubeX/mihomo/releases/download/Prerelease-Alpha',
	prizrak: 'https://github.com/legiz-ru/Prizrak-Core/releases/latest/download'
};

function package_version(name) {
	let version = null;
	let process;
	if (system('command -v opkg > /dev/null') == 0) {
		process = popen(`opkg list-installed '${name}' | cut -d ' ' -f 3`);
		if (process) {
			version = trim(process.read('all'));
			process.close();
		}
	} else if (system('command -v apk > /dev/null') == 0) {
		process = popen(`apk list -I '${name}' 2>/dev/null | cut -d ' ' -f 1`);
		if (process) {
			const line = trim(process.read('all'));
			process.close();
			if (index(line, `${name}-`) == 0) {
				version = substr(line, length(name) + 1);
			}
		}
	}
	return length(version) > 0 ? version : null;
}

function release_branch() {
	const release = {};
	for (let line in split(readfile('/etc/openwrt_release') ?? '', '\n')) {
		const m = match(line, /^(DISTRIB_[A-Z]+)='?([^']*)'?$/);
		if (m) {
			release[m[1]] = m[2];
		}
	}
	const version = release.DISTRIB_RELEASE ?? '';
	let branch = null;
	if (index(version, '24.10') >= 0) {
		branch = 'openwrt-24.10';
	} else if (index(version, '25.12') >= 0) {
		branch = 'openwrt-25.12';
	} else if (version == 'SNAPSHOT') {
		branch = 'SNAPSHOT';
	}
	return { arch: release.DISTRIB_ARCH, branch: branch };
}

const methods = {
	version: {
		call: function() {
			let process;
			let app = '';
			if (system('command -v opkg') == 0) {
				process = popen('opkg list-installed luci-app-exodus | cut -d " " -f 3');
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			} else if (system('command -v apk') == 0) {
				process = popen('apk list -I luci-app-exodus | cut -d " " -f 1 | cut -d "-" -f 4');
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			}
			let core = '';
			process = popen('mihomo -v | grep Mihomo | cut -d " " -f 3');
			if (process) {
				core = trim(process.read('all'));
				process.close();
			}
			return { app: app, core: core };
		}
	},
	profile: {
		args: { defaults: {} },
		call: function(req) {
			let profile = {};
			const defaults = req.args?.defaults ?? {};
			const filepath = '/etc/nikki/run/config.yaml';
			const tmpFilepath = '/var/run/nikki/profile.json';
			if (access(filepath, 'r')) {
				writefile(tmpFilepath, defaults);
				const command = `yq -M -p yaml -o json eval-all 'select(fi == 0) *? select(fi == 1)' ${tmpFilepath} ${filepath}`;
				const process = popen(command);
				if (process) {
					profile = json(process);
					process.close();
				}
			}
			return profile;
		}
	},
	update_subscription: {
		args: { section_id: 'section_id' },
		call: function(req) {
			let success = false;
			const section_id = req.args?.section_id;
			if (section_id) {
				// the service marks the result in the config, the info of the last successful update stays when it fails
				success = system(['service', 'nikki', 'update_subscription', section_id]) == 0
					&& cursor().get('nikki', section_id, 'success') == '1';
			}
			return { success: success };
		}
	},
	subscription_meta: {
		call: function() {
			// what the providers told in the headers on the last successful update, by subscription section id
			const result = {};
			for (let path in glob('/etc/nikki/subscriptions/*.json')) {
				const section_id = replace(substr(path, rindex(path, '/') + 1), /\.json$/, '');
				try {
					const meta = json(readfile(path) ?? '');
					if (type(meta) == 'object') {
						delete meta.source;
						result[section_id] = meta;
					}
				} catch (e) {
				}
			}
			return result;
		}
	},
	api: {
		args: { method: 'method', path: 'path', query: 'query', body: 'body' },
		call: function(req) {
			let result = {};

			const method = req.args?.method;
			const path = req.args?.path;
			const query = req.args?.query;
			const body = req.args?.body;

			const profile = load_profile();
			const api_listen = profile['external-controller'];
			const api_tls_listen = profile['external-controller-tls'];
			const api_secret = profile['secret'];
			if (!api_listen && !api_tls_listen) {
				return result;
			}

			const protocol = api_tls_listen ? 'https' : 'http';

			const url = (api_tls_listen ?? api_listen) + path;

			const process = popen(`curl --proto-default '${protocol}' --insecure --request '${method}' --oauth2-bearer '${api_secret}' --url-query '${query}' --data '${body}' '${url}'`);
			if (process) {
				result = json(process);
				process.close();
			}

			return result;
		}
	},
	get_identifiers: {
		call: function() {
			const users = filter(get_users(), (x) => x != '');
			const groups = filter(get_groups(), (x) => x != '');
			const cgroups = filter(get_cgroups(), (x) => x != '' && index(x, 'services/nikki') < 0);
			return { users: users, groups: groups, cgroups: cgroups };
		}
	},
	hwid: {
		call: function() {
			// the headers the service sends to subscriptions with Send HWID, and the hwid used when none is set
			const headers = {};
			let process = popen('. /etc/nikki/scripts/include.sh && hwid_headers');
			if (process) {
				for (let line in split(process.read('all'), '\n')) {
					const m = match(line, /^([a-z-]+): (.*)$/);
					if (m) {
						headers[m[1]] = m[2];
					}
				}
				process.close();
			}
			let generated = null;
			process = popen('. /etc/nikki/scripts/include.sh && generate_hwid');
			if (process) {
				generated = trim(process.read('all')) || null;
				process.close();
			}
			return { headers: headers, generated: generated };
		}
	},
	hard_update: {
		call: function() {
			// runs in background, restart may take longer than the rpc timeout
			const success = system('/etc/init.d/nikki hard_update > /dev/null 2>&1 &') == 0;
			return { success: success };
		}
	},
	check_update: {
		call: function() {
			const release = release_branch();
			const arch = release.arch;
			const branch = release.branch;
			const installed = {};
			for (let name in ['exodus', 'luci-app-exodus', 'mihomo-meta', 'mihomo-alpha']) {
				installed[name] = package_version(name);
			}
			// the installer saves the chosen core and the gh-proxy it downloads through
			const uci = cursor();
			const core_type = uci.get('nikki', 'update', 'core') ?? 'meta';
			let gh_proxy = rtrim(uci.get('nikki', 'update', 'gh_proxy') ?? '', '/');
			if (!match(gh_proxy, /^https?:\/\/[^' ]+$/)) {
				gh_proxy = null;
			}
			const gh_url = (url) => gh_proxy ? `${gh_proxy}/${url}` : url;
			let tag = null;
			let latest = null;
			let error = null;
			if (branch == null) {
				error = 'unsupported release';
			} else {
				const index_url = gh_url(`https://github.com/${repository}/releases/latest/download/exodus_${arch}-${branch}.json`);
				let process = popen(`curl -s -f -L -m 30 '${index_url}'`);
				if (process) {
					try {
						const release_index = json(process.read('all'));
						latest = release_index?.packages;
						tag = release_index?.tag;
					} catch (e) {
						latest = null;
					}
					process.close();
				}
				if (latest == null) {
					error = 'failed to fetch the latest release';
				}
				// older releases have no tag in the index, gh-proxy follows the redirect to the tag itself
				if (tag == null && gh_proxy == null) {
					process = popen(`curl -s -I -o /dev/null -m 15 -w '%{redirect_url}' 'https://github.com/${repository}/releases/latest'`);
					if (process) {
						const url = trim(process.read('all'));
						process.close();
						if (index(url, '/releases/tag/') >= 0) {
							tag = substr(url, rindex(url, '/') + 1);
						}
					}
				}
			}
			// an alternative core replaces the binary of mihomo-meta, its version is read from the binary
			const core = { type: core_type, installed: null, latest: null };
			let process = popen('mihomo -v 2>/dev/null | grep Mihomo | cut -d " " -f 3');
			if (process) {
				core.installed = trim(process.read('all')) || null;
				process.close();
			}
			if (core_releases[core_type]) {
				const version_url = gh_url(`${core_releases[core_type]}/version.txt`);
				process = popen(`curl -s -f -L -m 15 '${version_url}'`);
				if (process) {
					const version = trim(split(process.read('all'), '\n')[0]);
					process.close();
					if (match(version, /^[A-Za-z0-9._-]+$/)) {
						core.latest = version;
					}
				}
			}
			// free flash space and size of the current core, to decide if the core has to be removed before the update
			let free_space = null;
			process = popen("df -k /usr/libexec 2>/dev/null | tail -n 1 | awk '{print $4}'");
			if (process) {
				const kb = int(trim(process.read('all')));
				process.close();
				if (kb >= 0) {
					free_space = kb * 1024;
				}
			}
			const core_size = stat('/usr/libexec/mihomo')?.size;
			// the token is a part of the gh-proxy address, only the host is returned
			const gh_proxy_host = gh_proxy ? match(gh_proxy, /^[a-z]+:\/\/([^\/]+)/)[1] : null;
			return { tag: tag, arch: arch, branch: branch, installed: installed, latest: latest, core: core, gh_proxy: gh_proxy_host, error: error, free_space: free_space, core_size: core_size };
		}
	},
	update: {
		args: { low_space: false },
		call: function(req) {
			const low_space = req.args?.low_space ? '1' : '0';
			// run a copy of the installer detached from rpcd, the package upgrade replaces the original
			const command = `mkdir -p /var/log/nikki && cp -f /etc/nikki/scripts/install.sh /tmp/exodus-update.sh && ` +
				`(LOW_SPACE=${low_space} sh -c 'echo $$ > /sys/fs/cgroup/cgroup.procs 2>/dev/null; exec sh /tmp/exodus-update.sh' > /var/log/nikki/update.log 2>&1 &)`;
			const success = system(command) == 0;
			return { success: success };
		}
	},
	debug: {
		call: function() {
			const success = system('/etc/nikki/scripts/debug.sh > /var/log/nikki/debug.log') == 0;
			return { success: success };
		}
	}
};

return { 'luci.nikki': methods };